<Window x:Class="Xena.Desktop.CodeAgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="XENA // CODE AGENT" Width="1500" Height="920" MinWidth="1000" MinHeight="600"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen" AllowDrop="True">

    <Window.Resources>
        <!-- Dark selection colours for the explorer tree and lists -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#16384A" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#122838" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#D7E3EE" />

        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#B8C6D4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A2A3A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#160A05" />
            <Setter Property="Background" Value="{StaticResource OrangeBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <Setter Property="FontFamily" Value="Segoe UI" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar view switch (EXPLORER / SEARCH) -->
        <Style x:Key="ViewTab" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2" Padding="4,6,4,5" Margin="0,0,12,0">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clickable status bar item -->
        <Style x:Key="StatusBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#9FC7D3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="6,0">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="11" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#13384A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="Background" Value="#070C14" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
            <Setter Property="SelectionBrush" Value="#196C8F" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style x:Key="OptionToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="2,0,0,0">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="11.5" FontFamily="Cascadia Mono, Consolas" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="#102535" />
                                <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A2A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rows in the palette (go to file / commands) -->
        <Style x:Key="PaletteList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,4" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#13212F" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#16384A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- ═════════════ Toolbar ═════════════ -->
        <Border Grid.Row="0" Background="#0A1019" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE943;" Style="{StaticResource Glyph}" FontSize="16" Foreground="{StaticResource CyanBrush}" Margin="2,0,8,0" />
                    <TextBlock Text="CODE AGENT" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />

                    <Button Style="{StaticResource ToolBtn}" Click="OpenFolder_Click" ToolTip="Open a project folder (Ctrl+O)">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="Open Folder" /></StackPanel>
                    </Button>
                    <Button x:Name="RecentBtn" Style="{StaticResource ToolBtn}" Padding="5,5" Margin="-2,0,1,0" Click="Recent_Click" ToolTip="Open a recent folder">
                        <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="9" />
                    </Button>
                    <Button Style="{StaticResource ToolBtn}" Click="NewFile_Click" ToolTip="New file (Ctrl+N)">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="New File" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolBtn}" Click="Save_Click" ToolTip="Save (Ctrl+S)">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="Save" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolBtn}" Click="SaveAll_Click" ToolTip="Save all (Ctrl+Shift+S)">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE78C;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="Save All" /></StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{StaticResource LineBrush}" Margin="8,10" />

                    <Button x:Name="RunBtn" Style="{StaticResource ToolBtn}" Click="Run_Click" ToolTip="Run the current file (F5)">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" Foreground="{StaticResource GreenBrush}" Margin="0,0,6,0" /><TextBlock Text="Run" /></StackPanel>
                    </Button>
                    <Button x:Name="StopBtn" Style="{StaticResource ToolBtn}" Click="Stop_Click" IsEnabled="False" ToolTip="Stop the running program (Shift+F5)">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71A;" Style="{StaticResource Glyph}" Foreground="#E86B60" Margin="0,0,6,0" /><TextBlock Text="Stop" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolBtn}" Click="ToggleTerminal_Click" ToolTip="Show / hide the terminal (Ctrl+`)">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE756;" Style="{StaticResource Glyph}" Margin="0,0,6,0" /><TextBlock Text="Terminal" /></StackPanel>
                    </Button>
                </StackPanel>

                <!-- Centre: go to file / commands (like VS Code's title bar search) -->
                <Button Grid.Column="1" x:Name="PaletteBtn" Click="PaletteBtn_Click" HorizontalAlignment="Center" MinWidth="260" MaxWidth="460"
                        Margin="16,0" Cursor="Hand" ToolTip="Go to a file by name (Ctrl+P) · type &gt; for commands (Ctrl+Shift+P) · : for a line (Ctrl+G)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#070C14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="10,4">
                                <DockPanel>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Ctrl+P" DockPanel.Dock="Right" FontSize="10.5" Foreground="#4E6378" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock x:Name="PaletteHint" Text="Search files, commands…" FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3C566E" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="WorkspaceText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" MaxWidth="360"
                               FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <Button x:Name="SettingsBtn" Style="{StaticResource ToolBtn}" Padding="7,5" Click="Settings_Click" ToolTip="Editor settings">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════════ Main area ═════════════ -->
        <Grid Grid.Row="1" x:Name="MainArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="250" MinWidth="150" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition x:Name="ChatColumn" Width="410" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: Explorer / Search -->
            <Border Grid.Column="0" Background="#0A1019">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,4,6,2">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ExplorerTab" Style="{StaticResource ViewTab}" Content="EXPLORER" Click="ExplorerTab_Click" ToolTip="Files (Ctrl+Shift+E)" />
                            <Button x:Name="SearchTab" Style="{StaticResource ViewTab}" Content="SEARCH" Click="SearchTab_Click" ToolTip="Search in all files (Ctrl+Shift+F)" />
                        </StackPanel>
                        <StackPanel x:Name="ExplorerButtons" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ToolBtn}" Padding="5,4" Click="NewFile_Click" ToolTip="New file">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource Glyph}" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource ToolBtn}" Padding="5,4" Click="NewFolder_Click" ToolTip="New folder">
                                <TextBlock Text="&#xE8F4;" Style="{StaticResource Glyph}" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource ToolBtn}" Padding="5,4" Click="Refresh_Click" ToolTip="Refresh">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource ToolBtn}" Padding="5,4" Click="CollapseAll_Click" ToolTip="Collapse all folders">
                                <TextBlock Text="&#xE8A0;" Style="{StaticResource Glyph}" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <!-- Explorer view -->
                        <DockPanel x:Name="ExplorerView">
                            <StackPanel x:Name="ExplorerHint" DockPanel.Dock="Top" Margin="14,10,14,0">
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource MutedBrush}" FontFamily="Segoe UI"
                                           Text="No folder open. Open your project folder to browse and edit its files." />
                                <Button Style="{StaticResource AccentBtn}" Content="Open Folder" Click="OpenFolder_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#4E6378" FontFamily="Segoe UI" Margin="0,10,0,0"
                                           Text="Tip: you can also drag a folder or file onto this window." />
                            </StackPanel>
                            <TreeView x:Name="Explorer" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                      Padding="2,0" FontSize="12.5" SelectedItemChanged="Explorer_SelectedItemChanged" KeyDown="Explorer_KeyDown"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <TreeView.ContextMenu>
                                    <ContextMenu Opened="ExplorerMenu_Opened">
                                        <MenuItem Header="New File…" Click="NewFile_Click" />
                                        <MenuItem Header="New Folder…" Click="NewFolder_Click" />
                                        <Separator />
                                        <MenuItem x:Name="MenuRename" Header="Rename…" InputGestureText="F2" Click="Rename_Click" />
                                        <MenuItem x:Name="MenuDelete" Header="Delete (to Recycle Bin)" InputGestureText="Del" Click="Delete_Click" />
                                        <Separator />
                                        <MenuItem Header="Open in Terminal" Click="OpenInTerminal_Click" />
                                        <MenuItem Header="Reveal in File Explorer" Click="Reveal_Click" />
                                        <MenuItem Header="Copy Path" Click="CopyPath_Click" />
                                        <MenuItem Header="Copy Relative Path" Click="CopyRelativePath_Click" />
                                        <Separator />
                                        <MenuItem Header="Refresh" Click="Refresh_Click" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                            </TreeView>
                        </DockPanel>

                        <!-- Search view -->
                        <DockPanel x:Name="SearchView" Visibility="Collapsed" Margin="10,4,6,0">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBox x:Name="SearchBox" Style="{StaticResource DarkInput}" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"
                                         ToolTip="Search in all files of the project (Enter)" />
                                <DockPanel Margin="0,5,0,0">
                                    <ToggleButton x:Name="SearchCase" Style="{StaticResource OptionToggle}" Content="Aa" ToolTip="Match case" Click="SearchOption_Click" />
                                    <ToggleButton x:Name="SearchWord" Style="{StaticResource OptionToggle}" Content="ab" ToolTip="Whole word" Click="SearchOption_Click" />
                                    <ToggleButton x:Name="SearchRegex" Style="{StaticResource OptionToggle}" Content=".*" ToolTip="Regular expression" Click="SearchOption_Click" />
                                    <TextBlock x:Name="SearchSummary" Margin="8,0,0,0" FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </StackPanel>
                            <ScrollViewer x:Name="SearchScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                                <StackPanel x:Name="SearchResults" />
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource LineBrush}" />

            <!-- Editor + terminal -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition x:Name="TerminalSplitRow" Height="4" />
                    <RowDefinition x:Name="TerminalRow" Height="220" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#0A1019" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                    <ScrollViewer x:Name="TabScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="TabScroll_PreviewMouseWheel">
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="1" Background="#070C14">
                    <ae:TextEditor x:Name="Editor" Visibility="Collapsed" ShowLineNumbers="True"
                                   FontFamily="Cascadia Code, Consolas" FontSize="13.5"
                                   Background="#070C14" Foreground="#D4DEE8" LineNumbersForeground="#3E5366"
                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="6,4,0,0" />

                    <!-- Welcome page (no file open) -->
                    <ScrollViewer x:Name="EditorEmpty" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="40,40,40,30" HorizontalAlignment="Center" MaxWidth="760">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,28">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE943;" Style="{StaticResource Glyph}" FontSize="30" Foreground="{StaticResource CyanBrush}" Margin="0,0,14,0" />
                                    <TextBlock Text="Code Agent" FontFamily="Segoe UI Light" FontSize="30" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                                <TextBlock Text="Edit your code by hand, run it, and let Xena propose changes you approve one by one."
                                           FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="START" Style="{StaticResource PanelHeader}" Margin="0,0,0,8" />
                                <Button Style="{StaticResource ToolBtn}" Click="OpenFolder_Click" HorizontalAlignment="Left" Margin="-9,0,0,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" Foreground="{StaticResource CyanBrush}" Margin="0,0,10,0" /><TextBlock Text="Open Folder…" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource CyanBrush}" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolBtn}" Click="NewFile_Click" HorizontalAlignment="Left" Margin="-9,0,0,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource Glyph}" Foreground="{StaticResource CyanBrush}" Margin="0,0,10,0" /><TextBlock Text="New File…" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource CyanBrush}" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolBtn}" Click="PaletteBtn_Click" HorizontalAlignment="Left" Margin="-9,0,0,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="{StaticResource CyanBrush}" Margin="0,0,10,0" /><TextBlock Text="Go to File…" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource CyanBrush}" /></StackPanel>
                                </Button>

                                <TextBlock Text="RECENT" Style="{StaticResource PanelHeader}" Margin="0,24,0,8" />
                                <StackPanel x:Name="RecentList" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="SHORTCUTS" Style="{StaticResource PanelHeader}" Margin="0,0,0,8" />
                                <TextBlock x:Name="ShortcutList" FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource MutedBrush}" LineHeight="23" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows"
                              Background="{StaticResource LineBrush}" />

                <Border Grid.Row="3" x:Name="TerminalPanel" Background="#05090F">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="10,5,6,2">
                            <TextBlock Text="TERMINAL" Style="{StaticResource PanelHeader}" />
                            <TextBlock x:Name="TerminalState" Margin="12,0,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="FixBtn" Style="{StaticResource AccentBtn}" Padding="10,3" Margin="0,0,8,0" Visibility="Collapsed"
                                        Click="FixWithXena_Click" ToolTip="Send the error to Xena and ask for a fix" Content="&#9889; Fix with Xena" />
                                <Button Style="{StaticResource ToolBtn}" Padding="6,4" Click="ClearTerminal_Click" ToolTip="Clear (or type cls)">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="11" />
                                </Button>
                                <Button Style="{StaticResource ToolBtn}" Padding="6,4" Click="ToggleTerminal_Click" ToolTip="Hide terminal (Ctrl+`)">
                                    <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="10,2,10,6">
                            <TextBlock x:Name="TerminalPrompt" Foreground="{StaticResource CyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="12" MaxWidth="320" TextTrimming="CharacterEllipsis" Text="&#10095;" />
                            <TextBox x:Name="TerminalInput" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12.5" CaretBrush="{StaticResource CyanBrush}" SelectionBrush="#196C8F"
                                     PreviewKeyDown="TerminalInput_KeyDown"
                                     ToolTip="Type a command and press Enter (cd works; ↑↓ history; Ctrl+C stops a running program). While a program runs, what you type is its input." />
                        </DockPanel>
                        <TextBox x:Name="TerminalOutput" IsReadOnly="True" Background="Transparent" Foreground="#C8D3DE" BorderThickness="0"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12.5" TextWrapping="Wrap" Padding="8,0" SelectionBrush="#196C8F"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="TerminalOutput_MouseDoubleClick"
                                 ToolTip="Double-click a line like File &quot;x.py&quot;, line 12 (or x.js:12) to jump to it" ToolTipService.InitialShowDelay="1500" />
                    </DockPanel>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{StaticResource LineBrush}" />

            <!-- Xena panel -->
            <Border Grid.Column="4" Background="#0A1019">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,8,10,4">
                        <TextBlock Text="&#9673; XENA" Style="{StaticResource PanelHeader}" Foreground="{StaticResource CyanBrush}" />
                        <Button Style="{StaticResource ToolBtn}" Padding="6,3" Margin="8,0,0,0" Click="NewChat_Click" ToolTip="Start a new conversation" HorizontalAlignment="Left">
                            <TextBlock Text="New chat" FontSize="10.5" />
                        </Button>
                        <TextBlock x:Name="AgentState" Text="ready" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border DockPanel.Dock="Bottom" Margin="10,6,10,10" Background="#070C14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock x:Name="ContextText" Margin="10,8,10,0" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" Text="Context: no file open" />
                            <Grid Margin="10,6,10,4">
                                <TextBlock x:Name="AgentPlaceholder" IsHitTestVisible="False" TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="12.5"
                                           Foreground="#4E6378" Text="Ask Xena to change, fix, explain or create code…  (Enter to send, Shift+Enter for a new line, ↑ for your last request)" />
                                <TextBox x:Name="AgentInput" MinHeight="56" MaxHeight="170" AcceptsReturn="True" TextWrapping="Wrap"
                                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" SelectionBrush="#196C8F"
                                         FontFamily="Segoe UI" FontSize="12.5" CaretBrush="{StaticResource CyanBrush}"
                                         VerticalScrollBarVisibility="Auto" TextChanged="AgentInput_TextChanged" PreviewKeyDown="AgentInput_PreviewKeyDown" />
                            </Grid>
                            <DockPanel Margin="8,0,8,8">
                                <CheckBox x:Name="IncludeOpenFiles" Style="{StaticResource DarkCheck}" Content="Include open tabs"
                                          ToolTip="Also give Xena the other open files (slower, but she can edit several files)" />
                                <CheckBox x:Name="AutoSave" Style="{StaticResource DarkCheck}" Content="Save accepted changes" Margin="10,0,0,0"
                                          ToolTip="Write accepted changes to disk straight away" />
                                <Button x:Name="SendBtn" Style="{StaticResource AccentBtn}" Content="Send &#10148;" Click="Send_Click" HorizontalAlignment="Right"
                                        ToolTip="Send (Enter)" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="10,2,10,4">
                        <StackPanel x:Name="ChatPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═════════════ Status bar ═════════════ -->
        <Border Grid.Row="2" Background="#0B2530" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="6,0">
                <Button x:Name="StatusProblems" Style="{StaticResource StatusBtn}" Content="" Click="StatusProblems_Click" Visibility="Collapsed"
                        ToolTip="Go to the problem" Margin="0,0,6,0" />
                <TextBlock x:Name="StatusLeft" VerticalAlignment="Center" FontSize="11" Foreground="#9FC7D3" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="StatusPos" Style="{StaticResource StatusBtn}" Click="StatusPos_Click" ToolTip="Go to line (Ctrl+G)" />
                    <Button x:Name="StatusIndent" Style="{StaticResource StatusBtn}" Click="StatusIndent_Click" ToolTip="Change indentation" />
                    <TextBlock x:Name="StatusEnc" FontSize="11" Foreground="#9FC7D3" Margin="10,0,4,0" VerticalAlignment="Center" />
                    <Button x:Name="StatusEol" Style="{StaticResource StatusBtn}" Click="StatusEol_Click" ToolTip="Change line endings (LF / CRLF)" />
                    <TextBlock x:Name="StatusLang" FontSize="11" Foreground="#9FC7D3" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusXena" FontSize="11" Foreground="{StaticResource CyanBrush}" Margin="16,0,4,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═════════════ Palette overlay (go to file / commands / line) ═════════════ -->
        <Border x:Name="PaletteOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#66000000" MouseDown="PaletteOverlay_MouseDown">
            <Border x:Name="PaletteBox" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,46,0,0" Width="620"
                    Background="#0F1826" BorderBrush="#2A3D50" BorderThickness="1" CornerRadius="6" Padding="8" MouseDown="PaletteBox_MouseDown">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.6" />
                </Border.Effect>
                <DockPanel>
                    <TextBox x:Name="PaletteInput" DockPanel.Dock="Top" Style="{StaticResource DarkInput}" FontSize="13.5" Padding="8,6"
                             TextChanged="PaletteInput_TextChanged" PreviewKeyDown="PaletteInput_PreviewKeyDown" />
                    <TextBlock x:Name="PaletteInfo" DockPanel.Dock="Top" Margin="4,6,4,2" FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource MutedBrush}" />
                    <ListBox x:Name="PaletteList" Style="{StaticResource PaletteList}" MaxHeight="420" MouseUp="PaletteList_MouseUp" />
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</Window>
